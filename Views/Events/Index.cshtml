@model IEnumerable<EventListItemViewModel>
@{
    ViewData["Title"] = "Events";
}

<div class="p-4 mb-4 rounded-4 shadow-sm hero-card">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="display-6 fw-bold mb-2">School Event Registration</h1>
            <p class="mb-0">Browse events, check available seats, and register students quickly.</p>
        </div>
        <a class="btn btn-light btn-lg" asp-action="Create">Create Event</a>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-10">
        <input class="form-control form-control-lg" type="search" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search events by title" />
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-primary btn-lg" type="submit">Search</button>
    </div>
</form>

<div class="row g-4">
@foreach (var item in Model)
{
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <h2 class="h4 card-title">@item.Title</h2>
                    <span class="badge badge-soft rounded-pill">@item.SeatsLeft seats left</span>
                </div>
                <p class="text-muted small mb-2">@item.Date.ToString("MMM d, yyyy h:mm tt") • @item.Location</p>
                <p class="card-text flex-grow-1">@item.Description</p>
                <div class="progress mb-3" role="progressbar" aria-label="Registration capacity">
                    <div class="progress-bar" style="width:@(item.MaxParticipants == 0 ? 0 : item.RegisteredCount * 100 / item.MaxParticipants)%">
                        @item.RegisteredCount/@item.MaxParticipants
                    </div>
                </div>
                <div class="btn-group" role="group" aria-label="Event actions">
                    <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </div>
            </div>
        </div>
    </div>
}
</div>
