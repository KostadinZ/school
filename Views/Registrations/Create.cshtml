@model Registration
@{
    ViewData["Title"] = "Register Student";
}

<h1>Register Student</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EventId" class="form-label"></label>
        <select asp-for="EventId" class="form-select" asp-items="ViewBag.EventId"></select>
    </div>

    <div class="mb-3">
        <label asp-for="StudentId" class="form-label"></label>
        <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId"></select>
    </div>

    <button class="btn btn-primary" type="submit">Register</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
