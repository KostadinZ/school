@model Election?
@{
    ViewData["Title"] = "Home";
}

<section class="card">
    <h1>ASP.NET Core MVC School Voting System</h1>
    @if (Model is null)
    {
        <p>No election has been configured yet.</p>
    }
    else
    {
        <p><strong>Active Election:</strong> @Model.Name</p>
        <p>@Model.Description</p>
        <div class="actions">
            <a class="btn" asp-controller="Votes" asp-action="Cast">Vote Now</a>
            <a class="btn secondary" asp-controller="Votes" asp-action="Results">See Results</a>
        </div>
    }
</section>
