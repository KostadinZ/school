@model Event
@{
    ViewData["Title"] = "Event Details";
}

<h1>@Model.Title</h1>

<p>@Model.Description</p>
<p><strong>Date:</strong> @Model.Date.ToString("f")</p>
<p><strong>Location:</strong> @Model.Location</p>
<p><strong>Seats Left:</strong> @Model.SeatsLeft</p>

<p>
    <a class="btn btn-primary" asp-controller="Registrations" asp-action="Create">Register Student</a>
    <a class="btn btn-secondary" asp-action="Index">Back to Events</a>
</p>

<h2>Registered Students</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Class</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var registration in Model.Registrations)
    {
        <tr>
            <td>@registration.Student?.Name</td>
            <td>@registration.Student?.Email</td>
            <td>@registration.Student?.ClassName</td>
        </tr>
    }
    </tbody>
</table>
