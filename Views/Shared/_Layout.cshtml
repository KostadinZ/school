<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Event Registration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Events" asp-action="Index">School Events</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                <a class="nav-link" asp-controller="Students" asp-action="Index">Students</a>
                <a class="nav-link" asp-controller="Registrations" asp-action="Index">Registrations</a>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
